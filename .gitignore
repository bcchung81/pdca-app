# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# 이 저장소(bcchung81/pdca-app)는 공개입니다 — 코드만 올리고, 기관 자료·개인정보·비밀은 아래 목록으로 로컬에만 둡니다(2026-10-26).

# ── 의존성·빌드 산출물 ─────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
__pycache__/
*.pyc

# ── 로그·OS ──────────────────────────────────────────────────
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── 비밀 ─────────────────────────────────────────────────────
# .env.local에는 Supabase·Anthropic 키와 Vercel 배포 토큰이 있음. .env.example만 커밋
.env*
!.env.example
*.pem
# vercel link가 만드는 프로젝트 연결·vercel build 산출물. 배포에 올릴 파일은 .vercelignore(허용 목록)가 정함
.vercel

# ── 도구 상태 ────────────────────────────────────────────────
/.impeccable/

# ── 기관 자료·개인정보(로컬에만 — 따로 백업, 원본이 필요한 시험은 없으면 건너뜀) ──
# 기관 원본 바이너리(카드 HWP·PDF, 보고서·프레임워크 틀)
/data/
# 공통 지식 원본·파싱 산출물(운영에서는 관리자가 앱에 올림)
/resources/knowledge/
# 기관 내부 지침 사본(09·14·08·13 가공본) — 앱이 실행 중에 읽음. Vercel CLI 배포는 이 컴퓨터의 파일을 올리므로 운영에는 들어감
/resources/harness/pdca/
# 과제관리카드 59장 원문·그림(담당자 실명 포함)
/seed/cards/260916/
# 실제 초안으로 만든 시험 자료
/lib/reports/fixtures/
# 2025 보고서·공통 지식 분석(실명·연락처 포함), 평가 라운드 산출물
/docs/analysis/
# 컨설팅 자료·화면 시안·캡처(기관 과제 내용 포함)
/docs/consulting/
/docs/design/mockups/
/docs/design/evidence/
