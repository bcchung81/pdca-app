{
  "name": "pdca-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "knowledge:ingest": "node scripts/knowledge/ingest.ts",
    "knowledge:add": "node --conditions=react-server --env-file-if-exists=.env.local scripts/knowledge/add.ts",
    "knowledge:images": "node --conditions=react-server --env-file-if-exists=.env.local scripts/knowledge/images.ts",
    "knowledge:prune-images": "node --conditions=react-server --env-file-if-exists=.env.local scripts/knowledge/prune-images.ts",
    "knowledge:parse": "node --conditions=react-server scripts/knowledge/parse.ts",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/test/skip-summary.ts --test-reporter-destination=stdout \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "harness:sync": "node scripts/harness/sync.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db/seed.ts",
    "db:push": "node --env-file-if-exists=.env.local scripts/db/push.ts",
    "db:check-search": "node --env-file-if-exists=.env.local scripts/db/check-search.ts",
    "db:user": "node --env-file-if-exists=.env.local scripts/db/user.ts",
    "db:layout": "node --env-file-if-exists=.env.local scripts/db/layout.ts",
    "db:cards-mg": "node --env-file-if-exists=.env.local scripts/db/mgmt-cards.ts",
    "prep": "node --conditions=react-server --env-file-if-exists=.env.local scripts/prep/run.ts",
    "e2e": "node --env-file-if-exists=.env.local scripts/e2e/run.mjs",
    "e2e:ui": "node --env-file-if-exists=.env.local scripts/e2e/ui.mjs",
    "e2e:shots": "node --env-file-if-exists=.env.local scripts/e2e/shots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@xmldom/xmldom": "0.9.12",
    "cfb": "1.2.2",
    "clsx": "^2.1.1",
    "jpeg-js": "0.4.4",
    "jspreadsheet-ce": "5.0.4",
    "jsuites": "5.13.5",
    "jszip": "3.10.1",
    "kordoc": "4.15.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.8.0"
}
