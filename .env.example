# ── 운영(Vercel)에 넣는 변수 ──────────────────────────────────────────

# Supabase (서울 리전 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용(적재 스크립트·서버 코드). 브라우저 코드에서 쓰지 않음
SUPABASE_SECRET_KEY=

# 앱 주소(로그인 메일 링크 — app/login/actions.ts). 운영 도메인을 넣습니다(비우면 요청 호스트)
NEXT_PUBLIC_SITE_URL=
# 로그인: 쓸 수 있는 메일 도메인(쉼표 구분, 기본 kca.kr)
ALLOWED_EMAIL_DOMAINS=kca.kr

# AI 연결: 운영은 api(Claude API). Vercel에는 Claude Code CLI가 없어 cli를 못 씀(aiProviderFrom이 Vercel에서는 늘 api로 돌림)
AI_PROVIDER=api
ANTHROPIC_API_KEY=
# 예비 키(선택): 기본 키가 크레딧 부족으로 거절되면 같은 요청을 이 키로 다시 보냄. 비우면 전환 없음. 크레딧은 조직 단위라 다른 조직의 키여야 의미 있음
ANTHROPIC_API_KEY_FALLBACK=
# 모델 등급(lib/ai/models.ts의 「기능 → 등급」 표 — 지금 light는 과제 매칭뿐, 나머지 기능은 모두 heavy). 모두 비우면 아래 기본값
# heavy(작성지원·질문·코멘트·월간 점검·경평 초안): 모델(비우면 claude-sonnet-5-5)·생각 수준(low|medium|high|xhigh|max)
# 생각 수준을 비우면 기능별 표(lib/ai/models.ts FEATURE_EFFORT)를 따름 — 작성지원·질문·코멘트·블록 고치기 high, 나머지 heavy xhigh. 값을 적으면 모든 heavy 기능에 그 값(되돌리기: xhigh)
# 옛 이름 CLAUDE_MODEL_WRITER도 heavy 모델로 읽음(CLAUDE_MODEL_HEAVY가 앞)
CLAUDE_MODEL_HEAVY=
CLAUDE_EFFORT_HEAVY=
# light(과제 매칭 같은 분류·추출): 모델(비우면 claude-sonnet-5-5)·생각 수준(비우면 low)
CLAUDE_MODEL_LIGHT=
CLAUDE_EFFORT_LIGHT=

# 과제 매칭·준비물 백그라운드 처리(참고자료 3단계, lib/prep/)
# 작업 처리 라우트(/api/prep/run) 인증 — 크론이 `Authorization: Bearer <값>`으로 부름. 비우면 라우트는 늘 401(크론 설정은 docs/ops/운영-전환.md)
CRON_SECRET=
# 서버 액션 뒤 자동 처리: 비우면 Vercel은 자동(공통 지식 매칭 — 카드 한 장 약 45만 토큰)·로컬은 자동 처리 없음(`pnpm prep run --ai`로 직접), all=로컬에서도 자동, off=Vercel에서도 끔(수동)
PREP_AUTORUN=

# ── 로컬·스크립트 전용(운영에는 넣지 않음) ──────────────────────────────

# 마이그레이션 적용용 DB 연결(대시보드 Connect → Session pooler). pnpm db:push가 씀
SUPABASE_DB_URL=

# 운영 DB 보호용 — scripts 참고(DB_TARGET=production|development)
DB_TARGET=

# Claude Code CLI 경로일 때(AI_PROVIDER=cli, 로컬 개발용): 등급별 모델 별칭(둘 다 비우면 sonnet)·제한 시간(ms, 비우면 300000)·실행 파일(비우면 PATH의 claude)
# 생각 수준은 위 CLAUDE_EFFORT_HEAVY·CLAUDE_EFFORT_LIGHT가 CLI에도 적용됨(옛 CLAUDE_CLI_MODEL·CLAUDE_CLI_EFFORT도 heavy 값으로 읽음)
CLAUDE_CLI_MODEL_HEAVY=
CLAUDE_CLI_MODEL_LIGHT=
CLAUDE_CLI_TIMEOUT_MS=
CLAUDE_CLI_PATH=

# 평가 전용 Codex CLI 경로(AI_PROVIDER=codex — 경평 초안 모델 비교, lib/ai/codex-cli.ts): 모델(비우면 gpt-6-sol)·추론 수준(비우면 medium)·실행 파일(비우면 PATH의 codex). 제한 시간은 CLAUDE_CLI_TIMEOUT_MS를 같이 씀
CODEX_MODEL=
CODEX_EFFORT=
CODEX_CLI_PATH=
